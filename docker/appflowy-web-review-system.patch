+import { Button, LinearProgress, MenuItem, TextField } from '@mui/material';
+import { AxiosInstance } from 'axios';
+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import { useParams } from 'react-router-dom';
+import { toast } from 'sonner';
+
+import { useAppHandlers } from '@/components/app/app.hooks';
+import { useService } from '@/components/main/app.hooks';
+import {
+  createTaxonomy,
+  getCards,
+  getDashboard,
+  getTaxonomy,
+  submitReview,
+} from '@/components/review/api';
+import FlashcardFormDialog from '@/components/review/FlashcardFormDialog';
+import FlashcardImportDialog from '@/components/review/FlashcardImportDialog';
+import { ReviewCard, ReviewDashboard, TaxonomyNode } from '@/components/review/types';
+
+const difficulties = [
+  { value: 1, label: 'Muito fácil', color: 'bg-emerald-600' },
+  { value: 2, label: 'Fácil', color: 'bg-green-600' },
+  { value: 3, label: 'Médio', color: 'bg-blue-600' },
+  { value: 4, label: 'Difícil', color: 'bg-orange-600' },
+  { value: 5, label: 'Muito difícil', color: 'bg-red-600' },
+];
+
+function StatCard({ label, value, helper }: { label: string; value: React.ReactNode; helper?: string }) {
+  return (
+    <div className='rounded-2xl border border-border-primary bg-surface-container-layer-01 p-4'>
+      <div className='text-sm text-text-secondary'>{label}</div>
+      <div className='mt-1 text-2xl font-semibold text-text-primary'>{value}</div>
+      {helper && <div className='mt-1 text-xs text-text-tertiary'>{helper}</div>}
+    </div>

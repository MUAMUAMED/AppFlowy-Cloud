+import { AxiosInstance } from 'axios';
+
+import {
+  CreateCardPayload,
+  PageTaxonomySyncPayload,
+  ReviewCard,
+  ReviewDashboard,
+  ReviewResult,
+  TaxonomyNode,
+} from '@/components/review/types';
+
+interface AppResponse<T> {
+  code: number;
+  message: string;
+  data?: T;
+}
+
+function unwrap<T>(response: { data: AppResponse<T> }): T {
+  if (response.data.code !== 0 || response.data.data === undefined) {
+    throw new Error(response.data.message || 'Não foi possível concluir a operação');
+  }
+
+  return response.data.data;
+}
+
+export const timezoneOffsetMinutes = -new Date().getTimezoneOffset();
+
+export async function getDashboard(client: AxiosInstance, workspaceId: string) {
+  return unwrap<ReviewDashboard>(
+    await client.get(`/api/review/${workspaceId}/dashboard`, {
+      params: { timezone_offset_minutes: timezoneOffsetMinutes },
+    })
+  );
+}
+
+export async function getTaxonomy(client: AxiosInstance, workspaceId: string) {
+  return unwrap<TaxonomyNode[]>(await client.get(`/api/review/${workspaceId}/taxonomy`));
+}
+
+export async function createTaxonomy(
+  client: AxiosInstance,
+  workspaceId: string,
+  payload: { name: string; kind: TaxonomyNode['kind']; parent_id: string | null }
+) {
+  return unwrap<TaxonomyNode>(await client.post(`/api/review/${workspaceId}/taxonomy`, payload));
+}
+
+export async function syncPageTaxonomy(
+  client: AxiosInstance,
+  workspaceId: string,
+  payload: PageTaxonomySyncPayload
+) {
+  const response = await client.post<AppResponse<void>>(`/api/review/${workspaceId}/taxonomy/sync-pages`, payload);
+
+  if (response.data.code !== 0) {
+    throw new Error(response.data.message || 'NÃ£o foi possÃ­vel sincronizar as matÃ©rias');
+  }
+}
+
+export async function createCard(client: AxiosInstance, workspaceId: string, payload: CreateCardPayload) {
+  return unwrap<ReviewCard>(await client.post(`/api/review/${workspaceId}/cards`, payload));
+}
+
+export async function importCards(client: AxiosInstance, workspaceId: string, cards: CreateCardPayload[]) {
+  return unwrap<ReviewCard[]>(await client.post(`/api/review/${workspaceId}/cards/import`, { cards }));
+}
+
+export async function getCards(
+  client: AxiosInstance,
+  workspaceId: string,
+  filters: Partial<Record<'subject_id' | 'topic_id' | 'content_id' | 'tag' | 'card_type', string>>
+) {
+  return unwrap<ReviewCard[]>(
+    await client.get(`/api/review/${workspaceId}/cards`, {
+      params: { ...filters, timezone_offset_minutes: timezoneOffsetMinutes },
+    })
+  );
+}
+
+export async function submitReview(
+  client: AxiosInstance,
+  workspaceId: string,
+  cardId: string,
+  payload: {
+    difficulty: number;
+    selected_answer?: string;
+    correct?: boolean;
+    response_time_ms?: number;
+  }
+) {
+  return unwrap<ReviewResult>(
+    await client.post(`/api/review/${workspaceId}/cards/${cardId}/review`, {
+      ...payload,
+      timezone_offset_minutes: timezoneOffsetMinutes,
+    })
+  );
+}
diff --git a/src/components/review/flashcardImport.ts b/src/components/review/flashcardImport.ts
new file mode 100644
index 0000000..ffe0630
--- /dev/null
+++ b/src/components/review/flashcardImport.ts
@@ -0,0 +1,179 @@
+import { CardType } from '@/components/review/types';
+
+export const FLASHCARD_IMPORT_FORMAT = 'studyflashcards.v1';
+
+export type ImportDifficulty = 'muito_facil' | 'facil' | 'medio' | 'dificil' | 'muito_dificil';
+
+export interface ParsedImportCard {
+  type: CardType;
+  front: string;
+  back: string;
+  explanation: string;
+  choices: string[];
+  correct_answer: string;
+  difficulty: number;
+  tags: string[];
+}
+
+const difficultyMap: Record<ImportDifficulty, number> = {
+  muito_facil: 1,
+  facil: 2,
+  medio: 3,
+  dificil: 4,
+  muito_dificil: 5,
+};
+
+const example = {
+  format: FLASHCARD_IMPORT_FORMAT,
+  cards: [
+    {
+      type: 'classic',
+      front: 'O que é o crédito rotativo do cartão?',
+      back: 'É o financiamento do saldo da fatura que não foi pago integralmente.',
+      explanation: 'Use uma resposta curta e autossuficiente.',
+      difficulty: 'medio',
+      tags: ['cartao-de-credito'],
+    },
+    {
+      type: 'true_false',
+      front: 'O pagamento mínimo quita integralmente a fatura do cartão.',
+      correct_answer: false,
+      explanation: 'O saldo restante entra no crédito rotativo ou em parcelamento.',
+      difficulty: 'facil',
+      tags: ['cartao-de-credito'],
+    },
+    {
+      type: 'multiple_choice',
+      front: 'Qual operação ocorre quando apenas parte da fatura é paga?',
+      choices: ['Débito automático', 'Crédito rotativo', 'Estorno', 'Saque à vista'],
+      correct_answer: 'Crédito rotativo',
+      explanation: 'O valor não pago é financiado pela instituição emissora.',
+      difficulty: 'dificil',
+      tags: ['cartao-de-credito'],
+    },
+  ],
+};
+
+export const FLASHCARD_AI_PROMPT = `Você transforma imagens, transcrições e materiais de aula em flashcards para o StudyFlash.
+
+Responda SOMENTE com JSON válido. Não escreva introdução, comentários ou texto depois do JSON.
+Use exatamente o formato "${FLASHCARD_IMPORT_FORMAT}".
+
+Regras:
+1. Crie cartões autossuficientes, claros e sem depender da imagem original.
+2. Não invente informações ausentes no material.
+3. Elimine cartões repetidos ou que testem exatamente o mesmo conhecimento.
+4. Tipos permitidos: "classic", "true_false" e "multiple_choice".
+5. Dificuldades permitidas: "muito_facil", "facil", "medio", "dificil", "muito_dificil".
+6. classic exige front e back.
+7. true_false exige correct_answer booleano (true ou false) e explanation.
+8. multiple_choice exige pelo menos 2 choices; correct_answer deve ser idêntica a uma das choices.
+9. Use tags curtas, em minúsculas e sem #.
+10. Gere no máximo 200 cartões.
+
+Exemplo de saída:
+${JSON.stringify(example, null, 2)}`;
+
+function cleanJsonInput(input: string) {
+  const trimmed = input.trim();
+  const fenced = trimmed.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/i);
+  return fenced ? fenced[1] : trimmed;
+}
+
+function requiredString(value: unknown, field: string, index: number) {
+  if (typeof value !== 'string' || !value.trim()) {
+    throw new Error(`Cartão ${index + 1}: o campo ${field} é obrigatório.`);
+  }
+  return value.trim();
+}
+
+function optionalString(value: unknown) {
+  return typeof value === 'string' ? value.trim() : '';
+}
+
+export function parseFlashcardImport(input: string): ParsedImportCard[] {
+  if (!input.trim()) throw new Error('Cole o JSON gerado pela IA.');
+  let document: unknown;
+  try {
+    document = JSON.parse(cleanJsonInput(input));
+  } catch {
+    throw new Error('O texto não é um JSON válido. Peça para a IA responder somente com JSON.');
+  }
+  if (!document || typeof document !== 'object' || Array.isArray(document)) {
+    throw new Error('O documento precisa ser um objeto JSON.');
+  }
+  const root = document as Record<string, unknown>;
+  if (root.format !== FLASHCARD_IMPORT_FORMAT) {
+    throw new Error(`Formato inválido. Use exatamente "${FLASHCARD_IMPORT_FORMAT}".`);
+  }
+  if (!Array.isArray(root.cards) || root.cards.length === 0 || root.cards.length > 200) {
+    throw new Error('A importação deve conter entre 1 e 200 cartões.');
+  }
+
+  return root.cards.map((raw, index) => {
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) {
+      throw new Error(`Cartão ${index + 1}: estrutura inválida.`);
+    }
+    const card = raw as Record<string, unknown>;
+    const type = card.type as CardType;
+    if (!['classic', 'true_false', 'multiple_choice'].includes(type)) {
+      throw new Error(`Cartão ${index + 1}: tipo inválido.`);
+    }
+    const difficultyName = (card.difficulty || 'medio') as ImportDifficulty;
+    const difficulty = difficultyMap[difficultyName];
+    if (!difficulty) throw new Error(`Cartão ${index + 1}: dificuldade inválida.`);
+    const tags = Array.isArray(card.tags)
+      ? card.tags.map((tag) => optionalString(tag)).filter(Boolean)
+      : [];
+    const front = requiredString(card.front, 'front', index);
+    const explanation = optionalString(card.explanation);
+
+    if (type === 'classic') {
+      return {
+        type,
+        front,
+        back: requiredString(card.back, 'back', index),
+        explanation,
+        choices: [],
+        correct_answer: '',
+        difficulty,
+        tags,
+      };
+    }
+
+    if (type === 'true_false') {
+      if (typeof card.correct_answer !== 'boolean') {
+        throw new Error(`Cartão ${index + 1}: correct_answer deve ser true ou false.`);
+      }
+      return {
+        type,
+        front,
+        back: card.correct_answer ? 'true' : 'false',
+        explanation,
+        choices: [],
+        correct_answer: card.correct_answer ? 'true' : 'false',
+        difficulty,
+        tags,
+      };
+    }
+
+    const choices = Array.isArray(card.choices)
+      ? card.choices.map((choice) => optionalString(choice)).filter(Boolean)
+      : [];
+    const correctAnswer = requiredString(card.correct_answer, 'correct_answer', index);
+    if (choices.length < 2) throw new Error(`Cartão ${index + 1}: informe pelo menos duas alternativas.`);
+    if (!choices.includes(correctAnswer)) {
+      throw new Error(`Cartão ${index + 1}: correct_answer deve ser idêntica a uma das choices.`);
+    }
+    return {
+      type,
+      front,
+      back: correctAnswer,
+      explanation,
+      choices,
+      correct_answer: correctAnswer,
+      difficulty,
+      tags,
+    };
+  });
+}

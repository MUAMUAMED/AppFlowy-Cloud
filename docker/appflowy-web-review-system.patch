diff --git a/src/pages/GraphPage.tsx b/src/pages/GraphPage.tsx
new file mode 100644
index 0000000..c38a9bb
--- /dev/null
+++ b/src/pages/GraphPage.tsx
@@ -0,0 +1,410 @@
+import { LocateFixed, Network, Search, ZoomIn, ZoomOut } from 'lucide-react';
+import React, { PointerEvent, useMemo, useRef, useState, WheelEvent } from 'react';
+
+import { View } from '@/application/types';
+import { useAppHandlers, useAppOutline } from '@/components/app/app.hooks';
+
+type NodeKind = 'space' | 'subject' | 'topic' | 'content';
+
+interface GraphNode {
+  id: string;
+  label: string;
+  kind: NodeKind;
+  depth: number;
+  parentId?: string;
+  x: number;
+  y: number;
+  degree: number;
+}
+
+interface GraphEdge {
+  source: string;
+  target: string;
+}
+
+const nodeStyle: Record<NodeKind, { label: string; color: string; glow: string }> = {
+  space: { label: 'Espaço', color: '#8b5cf6', glow: 'rgba(139, 92, 246, 0.32)' },
+  subject: { label: 'Matéria', color: '#ec4899', glow: 'rgba(236, 72, 153, 0.34)' },
+  topic: { label: 'Tópico', color: '#06b6d4', glow: 'rgba(6, 182, 212, 0.32)' },
+  content: { label: 'Conteúdo', color: '#3b82f6', glow: 'rgba(59, 130, 246, 0.3)' },
+};
+
+function hash(value: string) {
+  let result = 2166136261;
+  for (let index = 0; index < value.length; index += 1) {
+    result ^= value.charCodeAt(index);
+    result = Math.imul(result, 16777619);
+  }
+  return Math.abs(result >>> 0);
+}
+
+function classify(view: View, parentKind?: NodeKind): NodeKind {
+  if (view.extra?.is_space) return 'space';
+  if (view.extra?.study_type === 'subject' || /#materia\b/i.test(view.name)) return 'subject';
+  if (parentKind === 'subject') return 'topic';
+  return 'content';
+}
+
+function createGraph(outline: View[]) {
+  const nodes: Omit<GraphNode, 'x' | 'y' | 'degree'>[] = [];
+  const edges: GraphEdge[] = [];
+  const visit = (views: View[], parentId?: string, depth = 0, parentKind?: NodeKind) => {
+    views.forEach((view) => {
+      const kind = classify(view, parentKind);
+      nodes.push({ id: view.view_id, label: view.name.trim() || 'Sem título', kind, depth, parentId });
+      if (parentId) edges.push({ source: parentId, target: view.view_id });
+      visit(view.children || [], view.view_id, depth + 1, kind);
+    });
+  };
+  visit(outline);
+  return { nodes, edges };
+}
+
+function forceLayout(inputNodes: Omit<GraphNode, 'x' | 'y' | 'degree'>[], edges: GraphEdge[]): GraphNode[] {
+  const centerX = 700;
+  const centerY = 420;
+  const degree = new Map<string, number>();
+  edges.forEach(({ source, target }) => {
+    degree.set(source, (degree.get(source) || 0) + 1);
+    degree.set(target, (degree.get(target) || 0) + 1);
+  });
+  const nodes = inputNodes.map((node, index) => {
+    const angle = (hash(node.id) % 6283) / 1000;
+    const radius = 80 + node.depth * 115 + (hash(`${node.id}-radius`) % 80);
+    return {
+      ...node,
+      x: centerX + Math.cos(angle) * radius + (index % 3) * 8,
+      y: centerY + Math.sin(angle) * radius + (index % 5) * 6,
+      degree: degree.get(node.id) || 0,
+      vx: 0,
+      vy: 0,
+    };
+  });
+  const byId = new Map(nodes.map((node) => [node.id, node]));
+  for (let iteration = 0; iteration < 190; iteration += 1) {
+    for (let left = 0; left < nodes.length; left += 1) {
+      for (let right = left + 1; right < nodes.length; right += 1) {
+        const a = nodes[left];
+        const b = nodes[right];
+        const dx = a.x - b.x || 0.1;
+        const dy = a.y - b.y || 0.1;
+        const distanceSquared = Math.max(140, dx * dx + dy * dy);
+        const force = 2400 / distanceSquared;
+        const distance = Math.sqrt(distanceSquared);
+        const fx = (dx / distance) * force;
+        const fy = (dy / distance) * force;
+        a.vx += fx;
+        a.vy += fy;
+        b.vx -= fx;
+        b.vy -= fy;
+      }
+    }
+    edges.forEach(({ source, target }) => {
+      const a = byId.get(source);
+      const b = byId.get(target);
+      if (!a || !b) return;
+      const dx = b.x - a.x;
+      const dy = b.y - a.y;
+      const distance = Math.max(1, Math.sqrt(dx * dx + dy * dy));
+      const force = (distance - (a.kind === 'space' ? 165 : 125)) * 0.012;
+      const fx = (dx / distance) * force;
+      const fy = (dy / distance) * force;
+      a.vx += fx;
+      a.vy += fy;
+      b.vx -= fx;
+      b.vy -= fy;
+    });
+    nodes.forEach((node) => {
+      node.vx = (node.vx + (centerX - node.x) * 0.0008) * 0.84;
+      node.vy = (node.vy + (centerY - node.y) * 0.0008) * 0.84;
+      node.x += node.vx;
+      node.y += node.vy;
+    });
+  }
+  return nodes.map(({ vx: _vx, vy: _vy, ...node }) => node);
+}
+
+function GraphPage() {
+  const outline = useAppOutline() || [];
+  const { openPageModal } = useAppHandlers();
+  const [search, setSearch] = useState('');
+  const [enabledKinds, setEnabledKinds] = useState<Record<NodeKind, boolean>>({
+    space: true,
+    subject: true,
+    topic: true,
+    content: true,
+  });
+  const [zoom, setZoom] = useState(0.62);
+  const [pan, setPan] = useState({ x: 0, y: 0 });
+  const [overrides, setOverrides] = useState<Record<string, { x: number; y: number }>>({});
+  const [hoveredId, setHoveredId] = useState<string>();
+  const svgRef = useRef<SVGSVGElement>(null);
+  const dragRef = useRef<{ id?: string; pointerId: number; moved: boolean }>();
+  const panRef = useRef<{ pointerId: number; x: number; y: number; originX: number; originY: number }>();
+
+  const graph = useMemo(() => createGraph(outline), [outline]);
+  const layoutNodes = useMemo(() => forceLayout(graph.nodes, graph.edges), [graph]);
+  const positionedNodes = useMemo(
+    () => layoutNodes.map((node) => ({ ...node, ...(overrides[node.id] || {}) })),
+    [layoutNodes, overrides]
+  );
+  const visibleIds = useMemo(() => {
+    const allowed = new Set(positionedNodes.filter((node) => enabledKinds[node.kind]).map((node) => node.id));
+    const term = search.trim().toLocaleLowerCase();
+    if (!term) return allowed;
+    const matches = positionedNodes.filter(
+      (node) => allowed.has(node.id) && node.label.toLocaleLowerCase().includes(term)
+    );
+    const result = new Set(matches.map((node) => node.id));
+    matches.forEach((match) => {
+      let parentId = match.parentId;
+      while (parentId) {
+        result.add(parentId);
+        parentId = positionedNodes.find((node) => node.id === parentId)?.parentId;
+      }
+      graph.edges.forEach((edge) => {
+        if (edge.source === match.id) result.add(edge.target);
+      });
+    });
+    return result;
+  }, [enabledKinds, graph.edges, positionedNodes, search]);
+  const visibleNodes = positionedNodes.filter((node) => visibleIds.has(node.id));
+  const visibleEdges = graph.edges.filter((edge) => visibleIds.has(edge.source) && visibleIds.has(edge.target));
+  const nodeById = new Map(positionedNodes.map((node) => [node.id, node]));
+
+  const toGraphPoint = (event: PointerEvent<SVGElement>) => {
+    const rect = svgRef.current?.getBoundingClientRect();
+    return {
+      x: (event.clientX - (rect?.left || 0) - pan.x) / zoom,
+      y: (event.clientY - (rect?.top || 0) - pan.y) / zoom,
+    };
+  };
+  const handleNodePointerDown = (event: PointerEvent<SVGGElement>, id: string) => {
+    event.stopPropagation();
+    dragRef.current = { id, pointerId: event.pointerId, moved: false };
+    event.currentTarget.setPointerCapture(event.pointerId);
+  };
+  const handleNodePointerMove = (event: PointerEvent<SVGGElement>, id: string) => {
+    if (dragRef.current?.id !== id || dragRef.current.pointerId !== event.pointerId) return;
+    dragRef.current.moved = true;
+    setOverrides((current) => ({ ...current, [id]: toGraphPoint(event) }));
+  };
+  const handleNodePointerUp = (event: PointerEvent<SVGGElement>, id: string) => {
+    if (dragRef.current?.id !== id) return;
+    const shouldOpen = !dragRef.current.moved;
+    dragRef.current = undefined;
+    if (shouldOpen) openPageModal?.(id);
+    event.currentTarget.releasePointerCapture(event.pointerId);
+  };
+  const handlePanStart = (event: PointerEvent<SVGSVGElement>) => {
+    if (event.target !== event.currentTarget) return;
+    panRef.current = { pointerId: event.pointerId, x: event.clientX, y: event.clientY, originX: pan.x, originY: pan.y };
+    event.currentTarget.setPointerCapture(event.pointerId);
+  };
+  const handlePanMove = (event: PointerEvent<SVGSVGElement>) => {
+    const active = panRef.current;
+    if (!active || active.pointerId !== event.pointerId) return;
+    setPan({ x: active.originX + event.clientX - active.x, y: active.originY + event.clientY - active.y });
+  };
+  const handlePanEnd = (event: PointerEvent<SVGSVGElement>) => {
+    if (panRef.current?.pointerId !== event.pointerId) return;
+    panRef.current = undefined;
+    event.currentTarget.releasePointerCapture(event.pointerId);
+  };
+  const handleWheel = (event: WheelEvent<SVGSVGElement>) => {
+    const nextZoom = Math.min(2.4, Math.max(0.3, zoom * (event.deltaY > 0 ? 0.9 : 1.1)));
+    const rect = svgRef.current?.getBoundingClientRect();
+    const mouseX = event.clientX - (rect?.left || 0);
+    const mouseY = event.clientY - (rect?.top || 0);
+    const graphX = (mouseX - pan.x) / zoom;
+    const graphY = (mouseY - pan.y) / zoom;
+    setPan({ x: mouseX - graphX * nextZoom, y: mouseY - graphY * nextZoom });
+    setZoom(nextZoom);
+  };
+  const resetViewport = () => {
+    setZoom(0.62);
+    setPan({ x: 0, y: 0 });
+    setOverrides({});
+  };
+
+  return (
+    <div className='flex h-full min-h-0 w-full flex-col overflow-hidden bg-surface-primary'>
+      <header className='flex flex-wrap items-center justify-between gap-4 border-b border-border-primary px-7 py-5'>
+        <div className='flex items-center gap-3'>
+          <div className='flex h-11 w-11 items-center justify-center rounded-2xl bg-purple-500/10 text-purple-500'>
+            <Network size={24} />
+          </div>
+          <div>
+            <div className='text-xs font-semibold uppercase tracking-[0.2em] text-purple-500'>Mapa do conhecimento</div>
+            <h1 className='text-2xl font-semibold text-text-primary'>Graph View</h1>
+          </div>
+        </div>
+        <div className='flex items-center gap-2 rounded-xl border border-border-primary bg-surface-container-layer-01 px-3 py-2'>
+          <Search size={17} className='text-text-tertiary' />
+          <input
+            value={search}
+            onChange={(event) => setSearch(event.target.value)}
+            placeholder='Buscar página...'
+            aria-label='Buscar página no gráfico'
+            className='w-56 bg-transparent text-sm text-text-primary outline-none placeholder:text-text-tertiary'
+          />
+        </div>
+      </header>
+      <div className='relative flex min-h-0 flex-1'>
+        <aside className='z-10 w-60 shrink-0 border-r border-border-primary bg-surface-container-layer-01 p-5'>
+          <div className='text-xs font-semibold uppercase tracking-wider text-text-tertiary'>Exibir</div>
+          <div className='mt-4 space-y-3'>
+            {(Object.keys(nodeStyle) as NodeKind[]).map((kind) => (
+              <label
+                key={kind}
+                className='flex cursor-pointer items-center justify-between gap-3 text-sm text-text-secondary'
+              >
+                <span className='flex items-center gap-2'>
+                  <span className='h-3 w-3 rounded-full' style={{ backgroundColor: nodeStyle[kind].color }} />
+                  {nodeStyle[kind].label}
+                </span>
+                <input
+                  type='checkbox'
+                  checked={enabledKinds[kind]}
+                  onChange={(event) => setEnabledKinds((current) => ({ ...current, [kind]: event.target.checked }))}
+                  className='h-4 w-4 accent-purple-500'
+                />
+              </label>
+            ))}
+          </div>
+          <div className='mt-7 border-t border-border-primary pt-5'>
+            <div className='text-xs font-semibold uppercase tracking-wider text-text-tertiary'>Resumo</div>
+            <div className='mt-3 grid grid-cols-2 gap-2'>
+              <div className='rounded-xl bg-surface-container-layer-02 p-3'>
+                <div className='text-xl font-semibold text-text-primary'>{visibleNodes.length}</div>
+                <div className='text-xs text-text-tertiary'>páginas</div>
+              </div>
+              <div className='rounded-xl bg-surface-container-layer-02 p-3'>
+                <div className='text-xl font-semibold text-text-primary'>{visibleEdges.length}</div>
+                <div className='text-xs text-text-tertiary'>conexões</div>
+              </div>
+            </div>
+          </div>
+          <p className='mt-6 text-xs leading-5 text-text-tertiary'>
+            Clique para abrir uma página. Arraste os nós para reorganizar e use a roda do mouse para ampliar.
+          </p>
+        </aside>
+        <div className='relative min-w-0 flex-1 overflow-hidden bg-[radial-gradient(circle_at_center,var(--fill-content-hover)_1px,transparent_1px)] [background-size:22px_22px]'>
+          {visibleNodes.length === 0 ? (
+            <div className='absolute inset-0 flex flex-col items-center justify-center text-center'>
+              <Network size={48} className='mb-4 text-text-tertiary' />
+              <div className='text-lg font-medium text-text-primary'>Nenhuma página encontrada</div>
+              <div className='mt-1 text-sm text-text-tertiary'>Altere a busca ou os filtros do gráfico.</div>
+            </div>
+          ) : null}
+          <svg
+            ref={svgRef}
+            className='h-full w-full cursor-grab touch-none active:cursor-grabbing'
+            onPointerDown={handlePanStart}
+            onPointerMove={handlePanMove}
+            onPointerUp={handlePanEnd}
+            onPointerCancel={handlePanEnd}
+            onWheel={handleWheel}
+          >
+            <g transform={`translate(${pan.x} ${pan.y}) scale(${zoom})`}>
+              {visibleEdges.map((edge) => {
+                const source = nodeById.get(edge.source);
+                const target = nodeById.get(edge.target);
+                if (!source || !target) return null;
+                const highlighted = hoveredId === edge.source || hoveredId === edge.target;
+                return (
+                  <line
+                    key={`${edge.source}-${edge.target}`}
+                    x1={source.x}
+                    y1={source.y}
+                    x2={target.x}
+                    y2={target.y}
+                    stroke={highlighted ? nodeStyle[target.kind].color : 'var(--border-primary)'}
+                    strokeWidth={highlighted ? 2.2 : 1.15}
+                    strokeOpacity={highlighted ? 0.9 : 0.62}
+                  />
+                );
+              })}
+              {visibleNodes.map((node) => {
+                const radius = Math.min(17, 8 + node.degree * 1.4 + (node.kind === 'subject' ? 3 : 0));
+                const active = hoveredId === node.id;
+                return (
+                  <g
+                    key={node.id}
+                    role='button'
+                    tabIndex={0}
+                    aria-label={`Abrir ${node.label}`}
+                    transform={`translate(${node.x} ${node.y})`}
+                    className='cursor-pointer outline-none'
+                    onPointerDown={(event) => handleNodePointerDown(event, node.id)}
+                    onPointerMove={(event) => handleNodePointerMove(event, node.id)}
+                    onPointerUp={(event) => handleNodePointerUp(event, node.id)}
+                    onPointerCancel={() => {
+                      dragRef.current = undefined;
+                    }}
+                    onMouseEnter={() => setHoveredId(node.id)}
+                    onMouseLeave={() => setHoveredId(undefined)}
+                    onKeyDown={(event) => {
+                      if (event.key === 'Enter' || event.key === ' ') openPageModal?.(node.id);
+                    }}
+                  >
+                    <circle
+                      r={radius + (active ? 7 : 4)}
+                      fill={nodeStyle[node.kind].glow}
+                      opacity={active ? 0.9 : 0.5}
+                    />
+                    <circle
+                      r={radius}
+                      fill={nodeStyle[node.kind].color}
+                      stroke='var(--surface-primary)'
+                      strokeWidth={3}
+                    />
+                    <text
+                      y={radius + 17}
+                      textAnchor='middle'
+                      className='select-none fill-text-primary text-[12px] font-medium'
+                      style={{
+                        paintOrder: 'stroke',
+                        stroke: 'var(--surface-primary)',
+                        strokeWidth: 4,
+                        strokeLinejoin: 'round',
+                      }}
+                    >
+                      {node.label.length > 27 ? `${node.label.slice(0, 25)}…` : node.label}
+                    </text>
+                  </g>
+                );
+              })}
+            </g>
+          </svg>
+          <div className='absolute bottom-5 right-5 flex items-center gap-1 rounded-xl border border-border-primary bg-surface-container-layer-01 p-1 shadow-lg'>
+            <button
+              aria-label='Diminuir zoom'
+              onClick={() => setZoom((current) => Math.max(0.3, current - 0.15))}
+              className='rounded-lg p-2 text-text-secondary hover:bg-fill-content-hover'
+            >
+              <ZoomOut size={18} />
+            </button>
+            <span className='w-12 text-center text-xs text-text-tertiary'>{Math.round(zoom * 100)}%</span>
+            <button
+              aria-label='Aumentar zoom'
+              onClick={() => setZoom((current) => Math.min(2.4, current + 0.15))}
+              className='rounded-lg p-2 text-text-secondary hover:bg-fill-content-hover'
+            >
+              <ZoomIn size={18} />
+            </button>
+            <button
+              aria-label='Centralizar gráfico'
+              onClick={resetViewport}
+              className='rounded-lg p-2 text-text-secondary hover:bg-fill-content-hover'
+            >
+              <LocateFixed size={18} />
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export default GraphPage;

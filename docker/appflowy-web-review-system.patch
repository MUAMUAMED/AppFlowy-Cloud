+}
+
+interface SessionProps {
+  cards: ReviewCard[];
+  title: string;
+  workspaceId: string;
+  client: AxiosInstance;
+  onExit: () => void;
+  onReviewed: () => Promise<void>;
+}
+
+function ReviewSession({ cards: initialCards, title, workspaceId, client, onExit, onReviewed }: SessionProps) {
+  const { openPageModal } = useAppHandlers();
+  const [cards, setCards] = useState(initialCards);
+  const [selectedAnswer, setSelectedAnswer] = useState('');
+  const [classicCorrect, setClassicCorrect] = useState<boolean | null>(null);
+  const [revealed, setRevealed] = useState(false);
+  const [submitting, setSubmitting] = useState(false);
+  const [startedAt, setStartedAt] = useState(Date.now());
+  const card = cards[0];
+
+  useEffect(() => {
+    setCards(initialCards);
+  }, [initialCards]);
+
+  if (!card) {
+    return (
+      <div className='mx-auto flex h-full max-w-xl flex-col items-center justify-center gap-5 p-8 text-center'>
+        <div className='text-6xl'>🎉</div>
+        <h2 className='text-2xl font-semibold'>Sessão concluída</h2>
+        <p className='text-text-secondary'>Não há mais cartões nesta seleção.</p>
+        <Button variant='contained' onClick={onExit}>Voltar para Revisão</Button>
+      </div>
+    );
+  }
+
+  const objectiveCorrect =
+    card.card_type === 'classic'
+      ? classicCorrect
+      : selectedAnswer
+        ? selectedAnswer.trim().toLowerCase() === card.correct_answer.trim().toLowerCase()
+        : null;
+
+  const chooseObjectiveAnswer = (answer: string) => {
+    if (revealed) return;
+    setSelectedAnswer(answer);
+    setRevealed(true);
+  };
+
+  const rate = async (difficulty: number) => {
+    if (objectiveCorrect === null) return;
+    setSubmitting(true);
+    try {
+      const result = await submitReview(client, workspaceId, card.card_id, {
+        difficulty,
+        selected_answer: card.card_type === 'classic' ? undefined : selectedAnswer,
+        correct: card.card_type === 'classic' ? objectiveCorrect : undefined,
+        response_time_ms: Date.now() - startedAt,
+      });
+      const bonus = result.completion_bonus ? ` + ${result.completion_bonus} XP de conclusão` : '';
+
+      toast.success(`${result.correct ? 'Resposta correta' : 'Revisão registrada'} · +${result.xp_awarded} XP${bonus}`);
+      setCards((current) => current.slice(1));
+      setSelectedAnswer('');
+      setClassicCorrect(null);
+      setRevealed(false);
+      setStartedAt(Date.now());
+      await onReviewed();
+    } catch (e) {
+      toast.error(e instanceof Error ? e.message : 'Não foi possível registrar a revisão.');
+    } finally {
+      setSubmitting(false);
+    }
+  };
+
+  const options = card.card_type === 'true_false' ? ['true', 'false'] : card.choices;
+
+  return (
+    <div className='mx-auto flex h-full w-full max-w-3xl flex-col px-6 py-5'>
+      <div className='mb-5 flex items-center justify-between'>
+        <div>
+          <div className='text-sm text-text-secondary'>{title}</div>
+          <div className='font-medium'>{cards.length} {cards.length === 1 ? 'cartão' : 'cartões'} nesta sessão</div>
+        </div>
+        <Button onClick={onExit}>Encerrar</Button>
+      </div>
+
+      <div className='flex flex-1 flex-col justify-center'>
+        <div className='rounded-3xl border border-border-primary bg-surface-container-layer-01 p-8 shadow-sm'>
+          <div className='mb-3 text-xs font-semibold uppercase tracking-wider text-text-tertiary'>
+            {card.card_type === 'classic'
+              ? 'Flashcard clássico'
+              : card.card_type === 'multiple_choice'
+                ? 'Múltipla escolha'
+                : 'Certo ou errado'}
+          </div>
+          <h2 className='whitespace-pre-wrap text-2xl font-semibold leading-relaxed'>{card.front}</h2>
+
+          {card.card_type === 'classic' && !revealed && (
+            <Button className='!mt-8' variant='contained' size='large' onClick={() => setRevealed(true)}>
+              Revelar resposta
+            </Button>
+          )}
+
+          {card.card_type !== 'classic' && (
+            <div className='mt-7 grid gap-3'>
+              {options.map((option) => {
+                const display = card.card_type === 'true_false' ? (option === 'true' ? 'Certo' : 'Errado') : option;
+                const isSelected = selectedAnswer === option;
+                const isCorrect = revealed && option.toLowerCase() === card.correct_answer.toLowerCase();
+
+                return (
+                  <button
+                    key={option}
+                    className={`rounded-xl border p-4 text-left transition ${
+                      isCorrect
+                        ? 'border-green-500 bg-green-50 text-green-800'
+                        : revealed && isSelected
+                          ? 'border-red-500 bg-red-50 text-red-800'
+                          : 'border-border-primary hover:bg-fill-content-hover'
+                    }`}
+                    disabled={revealed}
+                    onClick={() => chooseObjectiveAnswer(option)}
+                  >
+                    {display}
+                  </button>
+                );
+              })}
+            </div>
+          )}
+
+          {revealed && (
+            <div className='mt-7 space-y-4 border-t border-border-primary pt-6'>
+              {card.card_type === 'classic' ? (
+                <div className='whitespace-pre-wrap text-lg leading-relaxed'>{card.back}</div>
+              ) : (
+                <>
+                  <div className={`font-semibold ${objectiveCorrect ? 'text-green-700' : 'text-red-700'}`}>
+                    {objectiveCorrect ? 'Você acertou' : 'Você errou'}
+                  </div>
+                  <div>
+                    Resposta correta:{' '}
+                    <strong>
+                      {card.card_type === 'true_false'
+                        ? card.correct_answer === 'true'
+                          ? 'Certo'
+                          : 'Errado'
+                        : card.correct_answer}
+                    </strong>
+                  </div>
+                  {card.explanation && <div className='whitespace-pre-wrap text-text-secondary'>{card.explanation}</div>}
+                </>
+              )}
+
+              {card.card_type === 'classic' && classicCorrect === null && (
+                <div className='flex gap-3'>
+                  <Button color='error' variant='outlined' onClick={() => setClassicCorrect(false)}>Errei</Button>
+                  <Button color='success' variant='outlined' onClick={() => setClassicCorrect(true)}>Acertei</Button>
+                </div>
+              )}
+
+              {objectiveCorrect === false && card.source_view_id && openPageModal && (
+                <div className='rounded-xl border border-amber-300 bg-amber-50 p-4'>
+                  <div className='font-medium text-amber-900'>Quer conferir por que errou?</div>
+                  <div className='mt-1 text-sm text-amber-800'>Abra rapidamente a página vinculada sem sair desta revisão.</div>
+                  <Button className='!mt-3' color='warning' variant='outlined' onClick={() => openPageModal(card.source_view_id!)}>
+                    Rever conteúdo
+                  </Button>
+                </div>
+              )}
+
+              {objectiveCorrect !== null && (
+                <div>
+                  <div className='mb-3 text-sm font-medium'>Como foi a dificuldade?</div>
+                  <div className='grid grid-cols-2 gap-2 sm:grid-cols-5'>
+                    {difficulties.map((difficulty) => (
+                      <button
+                        key={difficulty.value}
+                        disabled={submitting}
+                        onClick={() => void rate(difficulty.value)}
+                        className={`${difficulty.color} rounded-xl px-3 py-3 text-sm font-medium text-white opacity-90 transition hover:opacity-100 disabled:opacity-50`}
+                      >
+                        {difficulty.label}
+                      </button>
+                    ))}
+                  </div>
+                </div>
+              )}
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+function ReviewPage() {
+  const { workspaceId = '' } = useParams();
+  const service = useService();
+  const client = service?.getAxiosInstance() || null;
+  const [dashboard, setDashboard] = useState<ReviewDashboard | null>(null);
+  const [taxonomy, setTaxonomy] = useState<TaxonomyNode[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [session, setSession] = useState<{ title: string; cards: ReviewCard[] } | null>(null);
+  const [createOpen, setCreateOpen] = useState(false);
+  const [importOpen, setImportOpen] = useState(false);
+  const [subjectId, setSubjectId] = useState('');
+  const [topicId, setTopicId] = useState('');
+  const [contentId, setContentId] = useState('');
+  const [taxonomyName, setTaxonomyName] = useState('');
+  const [taxonomyKind, setTaxonomyKind] = useState<TaxonomyNode['kind']>('subject');
+  const [taxonomyParent, setTaxonomyParent] = useState('');
+
+  const refresh = useCallback(async () => {
+    if (!client || !workspaceId) return;
+    const [nextDashboard, nextTaxonomy] = await Promise.all([
+      getDashboard(client, workspaceId),
+      getTaxonomy(client, workspaceId),
+    ]);
+
+    setDashboard(nextDashboard);
+    setTaxonomy(nextTaxonomy);
+  }, [client, workspaceId]);
+
+  useEffect(() => {
+    setLoading(true);
+    void refresh()
+      .catch((e) => toast.error(e instanceof Error ? e.message : 'Não foi possível carregar a revisão.'))
+      .finally(() => setLoading(false));
+  }, [refresh]);
+
+  const subjects = useMemo(() => taxonomy.filter((node) => node.kind === 'subject'), [taxonomy]);
+  const topics = useMemo(
+    () => taxonomy.filter((node) => node.kind === 'topic' && (!subjectId || node.parent_id === subjectId)),
+    [taxonomy, subjectId]
+  );
+  const contents = useMemo(
+    () => taxonomy.filter((node) => node.kind === 'content' && (!topicId || node.parent_id === topicId)),
+    [taxonomy, topicId]
+  );
+  const taxonomyParents = useMemo(() => {
+    if (taxonomyKind === 'topic') return subjects;
+    if (taxonomyKind === 'content') return taxonomy.filter((node) => node.kind === 'topic');
+    return [];
+  }, [subjects, taxonomy, taxonomyKind]);
+
+  if (!client || loading || !dashboard) {
+    return <div className='flex h-full items-center justify-center text-text-secondary'>Carregando Revisão…</div>;
+  }
+
+  if (session) {
+    return (
+      <ReviewSession
+        cards={session.cards}
+        title={session.title}
+        workspaceId={workspaceId}
+        client={client}
+        onExit={() => {
+          setSession(null);
+          void refresh();
+        }}
+        onReviewed={refresh}
+      />
+    );
+  }
+
+  const progress = dashboard.goal ? Math.round((dashboard.completed / dashboard.goal) * 100) : 100;
+
+  const startFilteredReview = async () => {
+    const cards = await getCards(client, workspaceId, {
+      ...(subjectId ? { subject_id: subjectId } : {}),
+      ...(topicId ? { topic_id: topicId } : {}),
+      ...(contentId ? { content_id: contentId } : {}),
+    });
+
+    setSession({ title: 'Revisão por conteúdo', cards });
+  };
+
+  const addTaxonomy = async () => {
+    if (!taxonomyName.trim()) return;
+    try {
+      await createTaxonomy(client, workspaceId, {
+        name: taxonomyName.trim(),
+        kind: taxonomyKind,
+        parent_id: taxonomyKind === 'subject' ? null : taxonomyParent || null,
+      });
+      setTaxonomyName('');
+      setTaxonomyParent('');
+      await refresh();
+      toast.success('Divisão criada');
+    } catch (e) {
+      toast.error(e instanceof Error ? e.message : 'Não foi possível criar a divisão.');
+    }
+  };
+
+  return (
+    <div className='h-full overflow-y-auto bg-background-primary'>
+      <div className='mx-auto max-w-6xl px-6 py-8'>
+        <div className='mb-8 flex flex-wrap items-start justify-between gap-4'>
+          <div>
+            <div className='mb-1 text-sm font-medium text-purple-600'>CENTRAL DE ESTUDOS</div>
+            <h1 className='text-3xl font-bold'>🧠 Revisão</h1>
+            <p className='mt-2 text-text-secondary'>Sua fila diária muda conforme os cartões programados para hoje.</p>
+          </div>
+          <div className='flex flex-wrap gap-2'>
+            <Button variant='outlined' size='large' onClick={() => setImportOpen(true)}>Importar com IA</Button>
+            <Button variant='contained' size='large' onClick={() => setCreateOpen(true)}>Novo flashcard</Button>
+          </div>
+        </div>
+
+        <div className='mb-6 grid grid-cols-2 gap-3 md:grid-cols-4'>
+          <StatCard label='Progresso de hoje' value={`${dashboard.completed}/${dashboard.goal}`} helper={`${dashboard.remaining} restantes`} />
+          <StatCard label='XP de hoje' value={`+${dashboard.xp_today}`} helper={`${dashboard.total_xp} XP total`} />
+          <StatCard label='Sequência' value={`🔥 ${dashboard.current_streak}`} helper={`Recorde: ${dashboard.longest_streak} dias`} />
+          <StatCard label='Nível' value={dashboard.level} helper={`${dashboard.reviewed_today} respostas hoje`} />
+        </div>
+
+        <div className='mb-6 rounded-2xl border border-border-primary bg-surface-container-layer-01 p-5'>
+          <div className='mb-3 flex items-center justify-between'>
+            <div>
+              <h2 className='text-lg font-semibold'>Revisão diária</h2>
+              <p className='text-sm text-text-secondary'>
+                {dashboard.overdue} atrasados · {dashboard.new_cards} novos · {dashboard.learning} em aprendizagem
+              </p>
+            </div>
+            {dashboard.remaining > 0 ? (
+              <Button variant='contained' onClick={() => setSession({ title: 'Revisão diária', cards: dashboard.queue })}>
+                {dashboard.completed ? 'Continuar' : 'Começar'}
+              </Button>
+            ) : (
+              <div className='font-medium text-green-700'>✓ Concluída</div>
+            )}
+          </div>
+          <LinearProgress variant='determinate' value={progress} className='!h-3 !rounded-full' />
+          <div className='mt-2 text-right text-sm text-text-secondary'>{progress}%</div>
+        </div>
+
+        <div className='grid gap-6 lg:grid-cols-2'>
+          <section className='rounded-2xl border border-border-primary bg-surface-container-layer-01 p-5'>
+            <h2 className='text-lg font-semibold'>Revisar por matéria ou tópico</h2>
+            <p className='mb-4 text-sm text-text-secondary'>A matéria inclui todos os tópicos e conteúdos abaixo dela.</p>
+            <div className='grid gap-3 sm:grid-cols-3'>
+              <TextField
+                select
+                label='Matéria'
+                value={subjectId}
+                onChange={(event) => {
+                  setSubjectId(event.target.value);
+                  setTopicId('');
+                  setContentId('');
+                }}
+              >
+                <MenuItem value=''>Todas</MenuItem>
+                {subjects.map((node) => <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>{node.name}</MenuItem>)}
+              </TextField>
+              <TextField
+                select
+                label='Tópico'
+                value={topicId}
+                disabled={!subjectId}
+                onChange={(event) => {
+                  setTopicId(event.target.value);
+                  setContentId('');
+                }}
+              >
+                <MenuItem value=''>Todos</MenuItem>
+                {topics.map((node) => <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>{node.name}</MenuItem>)}
+              </TextField>
+              <TextField
+                select
+                label='Conteúdo'
+                value={contentId}
+                disabled={!topicId}
+                onChange={(event) => setContentId(event.target.value)}
+              >
+                <MenuItem value=''>Todos</MenuItem>
+                {contents.map((node) => <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>{node.name}</MenuItem>)}
+              </TextField>
+            </div>
+            <Button className='!mt-4' variant='outlined' onClick={() => void startFilteredReview()}>Iniciar revisão filtrada</Button>
+          </section>
+
+          <section className='rounded-2xl border border-border-primary bg-surface-container-layer-01 p-5'>
+            <h2 className='text-lg font-semibold'>Criar divisões</h2>
+            <p className='mb-4 text-sm text-text-secondary'>Organize em Matéria → Tópico → Conteúdo.</p>
+            <div className='grid gap-3 sm:grid-cols-3'>
+              <TextField
+                select
+                label='Tipo'
+                value={taxonomyKind}
+                onChange={(event) => {
+                  setTaxonomyKind(event.target.value as TaxonomyNode['kind']);
+                  setTaxonomyParent('');
+                }}
+              >
+                <MenuItem value='subject'>Matéria</MenuItem>
+                <MenuItem value='topic'>Tópico</MenuItem>
+                <MenuItem value='content'>Conteúdo</MenuItem>
+              </TextField>
+              <TextField
+                select
+                label='Dentro de'
+                value={taxonomyParent}
+                disabled={taxonomyKind === 'subject'}
+                onChange={(event) => setTaxonomyParent(event.target.value)}
+              >
+                <MenuItem value=''>Selecione</MenuItem>
+                {taxonomyParents.map((node) => <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>{node.name}</MenuItem>)}
+              </TextField>
+              <TextField label='Nome' value={taxonomyName} onChange={(event) => setTaxonomyName(event.target.value)} />
+            </div>
+            <Button className='!mt-4' variant='outlined' onClick={() => void addTaxonomy()}>Criar divisão</Button>
+          </section>
+        </div>
+      </div>
+
+      <FlashcardFormDialog
+        open={createOpen}
+        workspaceId={workspaceId}
+        requestInstance={client}
+        onClose={() => setCreateOpen(false)}
+        onCreated={async () => {
+          await refresh();
+          toast.success('Flashcard adicionado à revisão diária');
+        }}
+      />
+      <FlashcardImportDialog
+        open={importOpen}
+        workspaceId={workspaceId}
+        requestInstance={client}
+        onClose={() => setImportOpen(false)}
+        onImported={async (cards) => {
+          await refresh();
+          toast.success(`${cards.length} flashcard${cards.length === 1 ? '' : 's'} importado${cards.length === 1 ? '' : 's'}`);
+        }}
+      />
+    </div>
+  );
+}
+
+export default ReviewPage;

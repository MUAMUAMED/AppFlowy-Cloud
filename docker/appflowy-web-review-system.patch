+export type CardType = 'classic' | 'multiple_choice' | 'true_false';
+
+export interface TaxonomyNode {
+  taxonomy_id: string;
+  parent_id: string | null;
+  kind: 'subject' | 'topic' | 'content';
+  name: string;
+  source_view_id?: string | null;
+}
+
+export interface PageTaxonomySyncPayload {
+  subjects: Array<{
+    view_id: string;
+    name: string;
+    topics: Array<{
+      view_id: string;
+      name: string;
+      contents: Array<{
+        view_id: string;
+        name: string;
+      }>;
+    }>;
+  }>;
+}
+
+export interface ReviewCard {
+  card_id: string;
+  card_type: CardType;
+  front: string;
+  back: string;
+  explanation: string;
+  choices: string[];
+  correct_answer: string;
+  subject_id: string | null;
+  topic_id: string | null;
+  content_id: string | null;
+  tags: string[];
+  source_view_id: string | null;
+  source_block_id: string | null;
+  state: string;
+  due_at: string;
+  interval_seconds: number;
+  difficulty_score: number;
+  correct_count: number;
+  incorrect_count: number;
+}
+
+export interface ReviewDashboard {

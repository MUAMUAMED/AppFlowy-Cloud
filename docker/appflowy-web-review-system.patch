diff --git a/src/components/review/FlashcardFormDialog.tsx b/src/components/review/FlashcardFormDialog.tsx
new file mode 100644
index 0000000..e72241a
--- /dev/null
+++ b/src/components/review/FlashcardFormDialog.tsx
@@ -0,0 +1,292 @@
+import {
+  Button,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  MenuItem,
+  TextField,
+} from '@mui/material';
+import { AxiosInstance } from 'axios';
+import React, { useEffect, useMemo, useState } from 'react';
+
+import { createCard, getTaxonomy, timezoneOffsetMinutes } from '@/components/review/api';
+import { CardType, ReviewCard, TaxonomyNode } from '@/components/review/types';
+
+interface Props {
+  open: boolean;
+  workspaceId: string;
+  requestInstance: AxiosInstance;
+  sourceViewId?: string;
+  onClose: () => void;
+  onCreated: (card: ReviewCard) => void | Promise<void>;
+}
+
+const cardTypes: Array<{ value: CardType; label: string }> = [
+  { value: 'classic', label: 'Clássico' },
+  { value: 'multiple_choice', label: 'Múltipla escolha' },
+  { value: 'true_false', label: 'Certo ou errado' },
+];
+
+export function FlashcardFormDialog({
+  open,
+  workspaceId,
+  requestInstance,
+  sourceViewId,
+  onClose,
+  onCreated,
+}: Props) {
+  const [taxonomy, setTaxonomy] = useState<TaxonomyNode[]>([]);
+  const [cardType, setCardType] = useState<CardType>('classic');
+  const [front, setFront] = useState('');
+  const [back, setBack] = useState('');
+  const [explanation, setExplanation] = useState('');
+  const [choicesText, setChoicesText] = useState('');
+  const [correctAnswer, setCorrectAnswer] = useState('');
+  const [subjectId, setSubjectId] = useState('');
+  const [topicId, setTopicId] = useState('');
+  const [contentId, setContentId] = useState('');
+  const [tags, setTags] = useState('');
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    if (!open) return;
+    void getTaxonomy(requestInstance, workspaceId)
+      .then(setTaxonomy)
+      .catch(() => setTaxonomy([]));
+  }, [open, requestInstance, workspaceId]);
+
+  const subjects = useMemo(() => taxonomy.filter((node) => node.kind === 'subject'), [taxonomy]);
+  const topics = useMemo(
+    () => taxonomy.filter((node) => node.kind === 'topic' && (!subjectId || node.parent_id === subjectId)),
+    [taxonomy, subjectId]
+  );
+  const contents = useMemo(
+    () => taxonomy.filter((node) => node.kind === 'content' && (!topicId || node.parent_id === topicId)),
+    [taxonomy, topicId]
+  );
+  const choices = useMemo(
+    () =>
+      choicesText
+        .split('\n')
+        .map((choice) => choice.trim())
+        .filter(Boolean),
+    [choicesText]
+  );
+
+  const reset = () => {
+    setCardType('classic');
+    setFront('');
+    setBack('');
+    setExplanation('');
+    setChoicesText('');
+    setCorrectAnswer('');
+    setSubjectId('');
+    setTopicId('');
+    setContentId('');
+    setTags('');
+    setError('');
+  };
+
+  const handleClose = () => {
+    if (saving) return;
+    reset();
+    onClose();
+  };
+
+  const submit = async () => {
+    setError('');
+    if (!front.trim()) {
+      setError('Escreva a frente ou o enunciado.');
+      return;
+    }
+    if (cardType === 'classic' && !back.trim()) {
+      setError('Escreva a resposta do cartão.');
+      return;
+    }
+    if (cardType === 'multiple_choice' && (choices.length < 2 || !correctAnswer)) {
+      setError('Informe pelo menos duas alternativas e escolha a resposta correta.');
+      return;
+    }
+    if (cardType === 'true_false' && !correctAnswer) {
+      setError('Escolha se a afirmação é certa ou errada.');
+      return;
+    }
+
+    setSaving(true);
+    try {
+      const card = await createCard(requestInstance, workspaceId, {
+        card_type: cardType,
+        front: front.trim(),
+        back: cardType === 'classic' ? back.trim() : correctAnswer,
+        explanation: explanation.trim(),
+        choices: cardType === 'multiple_choice' ? choices : [],
+        correct_answer: cardType === 'classic' ? '' : correctAnswer,
+        subject_id: subjectId || null,
+        topic_id: topicId || null,
+        content_id: contentId || null,
+        tags: tags
+          .split(',')
+          .map((tag) => tag.trim())
+          .filter(Boolean),
+        source_view_id: sourceViewId || null,
+        source_block_id: null,
+        timezone_offset_minutes: timezoneOffsetMinutes,
+      });
+
+      await onCreated(card);
+      reset();
+      onClose();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Não foi possível criar o flashcard.');
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onClose={handleClose} fullWidth maxWidth='sm'>
+      <DialogTitle>Novo flashcard global</DialogTitle>
+      <DialogContent className='flex flex-col gap-4 pt-2'>
+        <TextField
+          select
+          label='Formato'
+          value={cardType}
+          onChange={(event) => {
+            setCardType(event.target.value as CardType);
+            setCorrectAnswer('');
+          }}
+        >
+          {cardTypes.map((type) => (
+            <MenuItem key={type.value} value={type.value}>
+              {type.label}
+            </MenuItem>
+          ))}
+        </TextField>
+
+        <TextField
+          autoFocus
+          multiline
+          minRows={2}
+          label={cardType === 'classic' ? 'Frente' : 'Enunciado'}
+          value={front}
+          onChange={(event) => setFront(event.target.value)}
+        />
+
+        {cardType === 'classic' && (
+          <TextField multiline minRows={3} label='Resposta' value={back} onChange={(event) => setBack(event.target.value)} />
+        )}
+
+        {cardType === 'multiple_choice' && (
+          <>
+            <TextField
+              multiline
+              minRows={4}
+              label='Alternativas — uma por linha'
+              placeholder={'Alternativa A\nAlternativa B\nAlternativa C'}
+              value={choicesText}
+              onChange={(event) => setChoicesText(event.target.value)}
+            />
+            <TextField
+              select
+              label='Resposta correta'
+              value={correctAnswer}
+              onChange={(event) => setCorrectAnswer(event.target.value)}
+            >
+              {choices.map((choice) => (
+                <MenuItem key={choice} value={choice}>
+                  {choice}
+                </MenuItem>
+              ))}
+            </TextField>
+          </>
+        )}
+
+        {cardType === 'true_false' && (
+          <TextField
+            select
+            label='Gabarito'

+          </TextField>
+        )}
+
+        {cardType !== 'classic' && (
+          <TextField
+            multiline
+            minRows={2}
+            label='Explicação'
+            value={explanation}
+            onChange={(event) => setExplanation(event.target.value)}
+          />
+        )}
+
+        <div className='grid grid-cols-1 gap-3 sm:grid-cols-3'>
+          <TextField
+            select
+            label='Matéria'
+            value={subjectId}
+            onChange={(event) => {
+              setSubjectId(event.target.value);
+              setTopicId('');
+              setContentId('');
+            }}
+          >
+            <MenuItem value=''>Sem matéria</MenuItem>
+            {subjects.map((node) => (
+              <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>
+                {node.name}
+              </MenuItem>
+            ))}
+          </TextField>
+          <TextField
+            select
+            label='Tópico'
+            value={topicId}
+            disabled={!subjectId}
+            onChange={(event) => {
+              setTopicId(event.target.value);
+              setContentId('');
+            }}
+          >
+            <MenuItem value=''>Sem tópico</MenuItem>
+            {topics.map((node) => (
+              <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>
+                {node.name}
+              </MenuItem>
+            ))}
+          </TextField>
+          <TextField
+            select
+            label='Conteúdo'
+            value={contentId}
+            disabled={!topicId}
+            onChange={(event) => setContentId(event.target.value)}
+          >
+            <MenuItem value=''>Sem conteúdo</MenuItem>
+            {contents.map((node) => (
+              <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>
+                {node.name}
+              </MenuItem>
+            ))}
+          </TextField>
+        </div>
+
+        <TextField label='Tags, separadas por vírgula' value={tags} onChange={(event) => setTags(event.target.value)} />
+        {error && <div className='rounded-lg bg-red-50 p-3 text-sm text-red-700'>{error}</div>}
+      </DialogContent>
+      <DialogActions>
+        <Button onClick={handleClose} disabled={saving}>Cancelar</Button>
+        <Button variant='contained' onClick={() => void submit()} disabled={saving}>
+          {saving ? 'Salvando…' : 'Criar flashcard'}
+        </Button>
+      </DialogActions>
+    </Dialog>
+  );
+}
+
+export default FlashcardFormDialog;
diff --git a/src/components/review/FlashcardImportDialog.tsx b/src/components/review/FlashcardImportDialog.tsx
new file mode 100644
index 0000000..37e6a1e
--- /dev/null
+++ b/src/components/review/FlashcardImportDialog.tsx
@@ -0,0 +1,223 @@
+import {
+  Button,
+  Checkbox,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  FormControlLabel,
+  MenuItem,
+  TextField,
+} from '@mui/material';
+import { AxiosInstance } from 'axios';
+import React, { useEffect, useMemo, useState } from 'react';
+
+import { importCards, getTaxonomy, timezoneOffsetMinutes } from '@/components/review/api';
+import { FLASHCARD_AI_PROMPT, parseFlashcardImport } from '@/components/review/flashcardImport';
+import { ReviewCard, TaxonomyNode } from '@/components/review/types';
+
+interface Props {
+  open: boolean;
+  workspaceId: string;
+  requestInstance: AxiosInstance;
+  sourceViewId?: string;
+  onClose: () => void;
+  onImported: (cards: ReviewCard[], addToPage: boolean) => void | Promise<void>;
+}
+
+export function FlashcardImportDialog({
+  open,
+  workspaceId,
+  requestInstance,
+  sourceViewId,
+  onClose,
+  onImported,
+}: Props) {
+  const [input, setInput] = useState('');
+  const [taxonomy, setTaxonomy] = useState<TaxonomyNode[]>([]);
+  const [subjectId, setSubjectId] = useState('');
+  const [topicId, setTopicId] = useState('');
+  const [contentId, setContentId] = useState('');
+  const [commonTags, setCommonTags] = useState('');
+  const [addToPage, setAddToPage] = useState(Boolean(sourceViewId));
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    if (!open) return;
+    setAddToPage(Boolean(sourceViewId));
+    void getTaxonomy(requestInstance, workspaceId)
+      .then((nodes) => {
+        setTaxonomy(nodes);
+        if (!sourceViewId) return;
+        const match = nodes.find((node) => node.source_view_id === sourceViewId);
+        if (!match) return;
+        if (match.kind === 'subject') setSubjectId(match.taxonomy_id);
+        if (match.kind === 'topic') {
+          setTopicId(match.taxonomy_id);
+          setSubjectId(match.parent_id || '');
+        }
+        if (match.kind === 'content') {
+          setContentId(match.taxonomy_id);
+          setTopicId(match.parent_id || '');
+          const topic = nodes.find((node) => node.taxonomy_id === match.parent_id);
+          setSubjectId(topic?.parent_id || '');
+        }
+      })
+      .catch(() => setTaxonomy([]));
+  }, [open, requestInstance, sourceViewId, workspaceId]);
+
+  const parsed = useMemo(() => {
+    if (!input.trim()) return { cards: [], error: '' };
+    try {
+      return { cards: parseFlashcardImport(input), error: '' };
+    } catch (parseError) {
+      return { cards: [], error: parseError instanceof Error ? parseError.message : 'Formato inválido.' };
+    }
+  }, [input]);
+
+  const subjects = useMemo(() => taxonomy.filter((node) => node.kind === 'subject'), [taxonomy]);
+  const topics = useMemo(
+    () => taxonomy.filter((node) => node.kind === 'topic' && (!subjectId || node.parent_id === subjectId)),
+    [subjectId, taxonomy]
+  );
+  const contents = useMemo(
+    () => taxonomy.filter((node) => node.kind === 'content' && (!topicId || node.parent_id === topicId)),
+    [taxonomy, topicId]
+  );
+
+  const reset = () => {
+    setInput('');
+    setSubjectId('');
+    setTopicId('');
+    setContentId('');
+    setCommonTags('');
+    setError('');
+  };
+
+  const handleClose = () => {
+    if (saving) return;
+    reset();
+    onClose();
+  };
+
+  const copyPrompt = async () => {
+    try {
+      await navigator.clipboard.writeText(FLASHCARD_AI_PROMPT);
+      setError('Instruções copiadas. Cole-as na IA que vai processar as imagens.');
+    } catch {
+      setError('Não foi possível copiar. Selecione as instruções exibidas e copie manualmente.');
+    }
+  };
+
+  const submit = async () => {
+    setError('');
+    if (parsed.error || parsed.cards.length === 0) {
+      setError(parsed.error || 'Cole pelo menos um cartão válido.');
+      return;
+    }
+    const common = commonTags.split(',').map((tag) => tag.trim()).filter(Boolean);
+    const selectedSourceViewId = sourceViewId && addToPage
+      ? sourceViewId
+      : taxonomy.find((node) => node.taxonomy_id === (contentId || topicId || subjectId))?.source_view_id || null;
+
+    setSaving(true);
+    try {
+      const cards = await importCards(
+        requestInstance,
+        workspaceId,
+        parsed.cards.map((card) => ({
+          card_type: card.type,
+          front: card.front,
+          back: card.back,
+          explanation: card.explanation,
+          choices: card.choices,
+          correct_answer: card.correct_answer,
+          subject_id: subjectId || null,
+          topic_id: topicId || null,
+          content_id: contentId || null,
+          tags: [...card.tags, ...common],
+          source_view_id: selectedSourceViewId,
+          source_block_id: null,
+          timezone_offset_minutes: timezoneOffsetMinutes,
+          initial_difficulty: card.difficulty,
+        }))
+      );
+      await onImported(cards, Boolean(sourceViewId && addToPage));
+      reset();
+      onClose();
+    } catch (importError) {
+      setError(importError instanceof Error ? importError.message : 'Não foi possível importar os cartões.');
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <Dialog open={open} onClose={handleClose} fullWidth maxWidth='md'>
+      <DialogTitle>Importar flashcards com IA</DialogTitle>
+      <DialogContent className='flex flex-col gap-4 pt-2'>
+        <div className='rounded-xl border border-border-primary bg-fill-content-hover p-4 text-sm'>
+          <div className='font-semibold'>1. Prepare a sua IA</div>
+          <div className='mt-1 text-text-secondary'>Copie as instruções fixas, envie para a IA junto das imagens e depois cole aqui o JSON produzido.</div>
+          <Button className='!mt-3' size='small' variant='outlined' onClick={() => void copyPrompt()}>
+            Copiar instruções para a IA
+          </Button>
+        </div>
+
+        <TextField
+          label='JSON com todos os flashcards'
+          placeholder='{"format":"studyflashcards.v1","cards":[...]}'
+          multiline
+          minRows={10}
+          maxRows={18}
+          value={input}
+          onChange={(event) => setInput(event.target.value)}
+        />
+
+        {input.trim() && (
+          <div className={`rounded-lg p-3 text-sm ${parsed.error ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-800'}`}>
+            {parsed.error || `${parsed.cards.length} ${parsed.cards.length === 1 ? 'cartão reconhecido e pronto' : 'cartões reconhecidos e prontos'} para importar.`}
+          </div>
+        )}
+
+        <div className='grid grid-cols-1 gap-3 sm:grid-cols-3'>
+          <TextField select label='Matéria' value={subjectId} onChange={(event) => {
+            setSubjectId(event.target.value); setTopicId(''); setContentId('');
+          }}>
+            <MenuItem value=''>Sem matéria</MenuItem>
+            {subjects.map((node) => <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>{node.name}</MenuItem>)}
+          </TextField>
+          <TextField select label='Tópico' value={topicId} disabled={!subjectId} onChange={(event) => {
+            setTopicId(event.target.value); setContentId('');
+          }}>
+            <MenuItem value=''>Sem tópico</MenuItem>
+            {topics.map((node) => <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>{node.name}</MenuItem>)}
+          </TextField>
+          <TextField select label='Conteúdo' value={contentId} disabled={!topicId} onChange={(event) => setContentId(event.target.value)}>
+            <MenuItem value=''>Sem conteúdo</MenuItem>
+            {contents.map((node) => <MenuItem key={node.taxonomy_id} value={node.taxonomy_id}>{node.name}</MenuItem>)}
+          </TextField>
+        </div>
+
+        <TextField label='Tags extras para todos, separadas por vírgula' value={commonTags} onChange={(event) => setCommonTags(event.target.value)} />
+
+        {sourceViewId && (
+          <FormControlLabel
+            control={<Checkbox checked={addToPage} onChange={(event) => setAddToPage(event.target.checked)} />}
+            label='Adicionar também nesta página e vinculá-la ao botão “Rever conteúdo”'
+          />
+        )}
+        {error && <div className='rounded-lg bg-blue-50 p-3 text-sm text-blue-800'>{error}</div>}
+      </DialogContent>
+      <DialogActions>
+        <Button onClick={handleClose} disabled={saving}>Cancelar</Button>
+        <Button variant='contained' onClick={() => void submit()} disabled={saving || parsed.cards.length === 0}>
+          {saving ? 'Importando…' : `Importar ${parsed.cards.length || ''} flashcards`}
+        </Button>
+      </DialogActions>
+    </Dialog>
+  );
+}
+
+export default FlashcardImportDialog;

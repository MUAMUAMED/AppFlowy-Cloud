+import React, { useCallback, useEffect, useState } from 'react';
+
+import { UpdatePagePayload, ViewExtra, ViewIconType } from '@/application/types';
+import { notify } from '@/components/_shared/notify';
+
+type StudyType = NonNullable<ViewExtra['study_type']> | '';
+
+interface StudyTypePropertyProps {
+  extra?: ViewExtra | null;
+  icon?: { ty: number; value: string } | null;
+  maxWidth?: number;
+  name?: string;
+  readOnly?: boolean;
+  updatePage?: (viewId: string, data: UpdatePagePayload) => Promise<void>;
+  viewId?: string;
+}
+
+function StudyTypeProperty({
+  extra,
+  icon,
+  maxWidth,
+  name,
+  readOnly,
+  updatePage,
+  viewId,
+}: StudyTypePropertyProps) {
+  const [studyType, setStudyType] = useState<StudyType>(extra?.study_type || '');
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    setStudyType(extra?.study_type || '');
+  }, [extra?.study_type, viewId]);
+
+  const handleChange = useCallback(
+    async (event: React.ChangeEvent<HTMLSelectElement>) => {
+      if (!updatePage || !viewId || readOnly) return;
+      const nextStudyType = event.target.value as StudyType;
+      const previousStudyType = studyType;
+
+      setStudyType(nextStudyType);
+      setSaving(true);
+      try {
+        await updatePage(viewId, {
+          name: name || '',
+          icon: icon
+            ? {
+                ty: icon.ty as ViewIconType,
+                value: icon.value,
+              }
+            : undefined,
+          extra: {
+            ...(extra || {}),
+            study_type: nextStudyType || undefined,
+          },
+        });
+      } catch (error) {
+        setStudyType(previousStudyType);
+        notify.error(error instanceof Error ? error.message : 'Não foi possível salvar a propriedade');
+      } finally {
+        setSaving(false);
+      }
+    },
+    [extra, icon, name, readOnly, studyType, updatePage, viewId]
+  );
+
+  return (
+    <div
+      data-testid='study-type-property'
+      style={{ width: maxWidth || '100%' }}
+      className='mt-3 flex max-w-full items-center gap-4 px-24 text-sm max-sm:px-6'
+    >
+      <span className='w-36 shrink-0 text-text-secondary'>Tipo de estudo</span>
+      <select
+        aria-label='Tipo de estudo'
+        value={studyType}
+        disabled={readOnly || saving}
+        onChange={handleChange}
+        className='h-8 min-w-48 rounded-md border border-border-primary bg-transparent px-2 text-text-primary outline-none hover:bg-fill-content-hover focus:border-border-primary'
+      >
+        <option value=''>Não definido</option>
+        <option value='subject'>Matéria</option>
+        <option value='content'>Conteúdo</option>
+      </select>
+      {saving ? <span className='text-xs text-text-tertiary'>Salvando…</span> : null}
+    </div>
+  );
+}
+
+export default StudyTypeProperty;
